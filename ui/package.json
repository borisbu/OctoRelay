{
  "name": "octorelay-ui",
  "description": "The UI scripts for OctoRelay plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Anna Bocharova",
    "url": "https://github.com/RobinTail"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "lint": "oxlint && oxfmt --check",
    "test": "tsc --noEmit && TZ=UTC vitest run --coverage --exclude qa*",
    "build": "pnpm build:js && pnpm build:styles && pnpm build:qa",
    "build:js": "tsdown && git restore ../**/.gitkeep",
    "build:styles": "lessc styles/octorelay.less ../octoprint_octorelay/static/css/octorelay.css",
    "build:qa": "vitest run qa.spec.ts"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jquery": "^3.5.34",
    "@types/lodash": "^3.10.9",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-allowed-dependencies": "^3.1.0",
    "happy-dom": "^20.11.1",
    "less": "^4.8.1",
    "oxfmt": "0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
