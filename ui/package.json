{
  "name": "octorelay-ui",
  "description": "The UI scripts for OctoRelay plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Anna Bocharova",
    "url": "https://github.com/RobinTail"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "lint": "oxlint && oxfmt --check",
    "test": "tsc --noEmit && TZ=UTC vitest run --coverage --exclude qa*",
    "build": "pnpm build:js && pnpm build:styles && pnpm build:qa",
    "build:js": "tsdown && git restore ../**/.gitkeep",
    "build:styles": "lessc styles/octorelay.less ../octoprint_octorelay/static/css/octorelay.css",
    "build:qa": "vitest run qa.spec.ts"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/jquery": "^3.5.34",
    "@types/lodash": "^3.10.9",
    "@types/node": "^26.6.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-allowed-dependencies": "^3.1.0",
    "happy-dom": "^20.11.1",
    "less": "^4.8.1",
    "oxfmt": "0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
